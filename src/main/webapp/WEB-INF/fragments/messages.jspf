<c:if test="${not empty errors.form}"><div class="alert alert-danger" role="alert"><c:out value="${errors.form}"/></div></c:if>
<c:if test="${not empty errors.id}"><div class="alert alert-danger" role="alert"><c:out value="${errors.id}"/></div></c:if>
<c:if test="${not empty message}"><div class="alert alert-success" role="status"><c:out value="${message}"/></div></c:if>