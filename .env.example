# Reference only: set variables on the application/Tomcat process.
# This project does not automatically read .env.
DB_URL=jdbc:sqlserver://localhost:1433;databaseName=jakartaJPA;encrypt=true;trustServerCertificate=true
DB_USERNAME=YOUR_SQL_LOGIN
DB_PASSWORD=YOUR_SQL_PASSWORD
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your-account@gmail.com
MAIL_PASSWORD=YOUR_GMAIL_APP_PASSWORD
MAIL_FROM=your-account@gmail.com
UPLOAD_DIR=D:/webapp-data/uploads
# Reserved for the planned Spring Boot seeder; not implemented yet.
SEED_SAMPLE_DATA=false